#usda 1.0
(
    defaultPrim = "World"
    doc = """restroom_map - Floor1 entry straight lengthened 250 -> 290 mm.

Floor1 route: riser at (x 0.330, y 0.850) -> 90 deg elbow R = 150 mm -> straight
along +X at y = 0.850, z = -2.7402 -> T junction.

  original : elbow tangent x = 0.480, T centreline x = 0.730   -> straight 250 mm
  this file: elbow tangent x = 0.480, T centreline x = 0.770   -> straight 290 mm

Everything at x > 0.60 (the T fitting, the 3482 mm loop, and the sump under it)
was translated +40 mm in X.  The riser and the elbow did not move, so the robot
start pose is unchanged.  The loop itself is only translated, not resized, so its
3482 mm perimeter is the same.

  mission script: JUNCTION_LOCAL = (0.7700, 0.8500, -2.7402)"""
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Concrete"
        {
            token outputs:surface.connect = </World/Looks/Concrete/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.74, 0.73, 0.70)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "Pipe"
        {
            token outputs:surface.connect = </World/Looks/Pipe/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.40, 0.45)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.45
                token outputs:surface
            }
        }
    }

    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        custom bool physxScene:enableCCD = 1
        custom token physxScene:solverType = "TGS"
        custom uint physxScene:timeStepsPerSecond = 240
    }

    def Scope "Looks_PhysicsMaterials"
    {
        def Material "PipeSteel" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1.1
            float physics:restitution = 0
            float physics:staticFriction = 1.3
        }
    }

    def Xform "Restroom"
    {

        def Xform "Floor2_Room"
