#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        custom bool physxScene:enableCCD = 1
        custom token physxScene:solverType = "TGS"
        custom uint physxScene:timeStepsPerSecond = 240
    }

    def "Looks"
    {
        def Material "RedBodyMat"
        {
            token outputs:surface.connect = </World/Looks/RedBodyMat/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.055, 0.055)
                float inputs:metallic = 0.7
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "RedHousingMat"
        {
            token outputs:surface.connect = </World/Looks/RedHousingMat/Shader.outputs:surface>

            def Shader "Shader"
            {
